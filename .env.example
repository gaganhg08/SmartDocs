# ==============================================================================
# SmartDocs - Environment Configuration Template
# ==============================================================================
# Instructions for Windows Users:
# 1. Copy this file and rename it to ".env":
#    In PowerShell: Copy-Item .env.example .env
# 2. Modify any values below if needed (the defaults work out of the box).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ollama Local LLM Configuration
# ------------------------------------------------------------------------------
# The base URL where your local Ollama server is running (default: http://localhost:11434).
OLLAMA_BASE_URL=http://localhost:11434

# The model name to use for Q&A and Summarization.
# Options:
#   - llama3.2       (Recommended default: 3B parameters, ~2.0 GB disk, ~3.8 GB RAM)
#   - llama3.2:1b    (Ultra-lightweight: 1B parameters, ~1.3 GB disk, ~1.5 GB RAM)
#   - phi3:mini      (Lightweight Microsoft 3.8B model, ~2.3 GB disk)
#   - mistral        (Higher capability: 7B parameters, ~4.1 GB disk, ~8 GB RAM)
OLLAMA_MODEL=llama3.2

# Sampling temperature (0.0 = deterministic and factual; recommended for RAG)
OLLAMA_TEMPERATURE=0.0

# HTTP request timeout in seconds when waiting for Ollama to generate an answer
OLLAMA_TIMEOUT=60

# ------------------------------------------------------------------------------
# 2. Sentence Transformers Embedding Configuration
# ------------------------------------------------------------------------------
# The local HuggingFace embedding model used to vectorize document chunks.
# Default: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions, ~90 MB disk)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Compute device: "cpu" (standard for all PCs) or "cuda" (if NVIDIA GPU with PyTorch CUDA is installed)
EMBEDDING_DEVICE=cpu

# ------------------------------------------------------------------------------
# 3. Document Processing & Text Chunking
# ------------------------------------------------------------------------------
# Maximum number of characters per text chunk (default: 1000 characters ~ 150-200 words)
CHUNK_SIZE=1000

# Overlap between adjacent chunks to maintain context across chunk boundaries
CHUNK_OVERLAP=200

# Maximum allowed uploaded PDF size in Megabytes
MAX_FILE_SIZE_MB=20

# ------------------------------------------------------------------------------
# 4. FAISS Vector Search Retrieval
# ------------------------------------------------------------------------------
# Number of most relevant document passages to retrieve for answering each query
TOP_K=4
