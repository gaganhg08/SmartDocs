# ==============================================================================
# SmartDocs - Environment Configuration Template
# Copy this file to .env and supply your local configuration and API keys.
# DO NOT commit the .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Supported options: openai, google, anthropic, ollama
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai

# OpenAI Configuration (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.0

# Google Gemini Configuration (Required if LLM_PROVIDER=google)
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL_NAME=gemini-1.5-flash

# Anthropic Configuration (Required if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-20241022

# Ollama / Local LLM Configuration (Required if LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_NAME=llama3.1

# ------------------------------------------------------------------------------
# Embedding Model Configuration
# ------------------------------------------------------------------------------
# Local Sentence Transformers model name or path
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ------------------------------------------------------------------------------
# Document Chunking & Ingestion Settings
# ------------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ------------------------------------------------------------------------------
# Vector Store (FAISS) Configuration
# ------------------------------------------------------------------------------
VECTOR_STORE_DIR=./data/faiss_index
TOP_K_RETRIEVAL=4
SIMILARITY_SCORE_THRESHOLD=0.5

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=True
STREAMLIT_SERVER_PORT=8501
